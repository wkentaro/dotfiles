          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "[ ! -f '/Users/wkentaro/.agents/skills/impeccable/scripts/hook.mjs' ] || node '/Users/wkentaro/.agents/skills/impeccable/scripts/hook.mjs'",
            "commandWindows": "if exist \"/Users/wkentaro/.agents/skills/impeccable/scripts/hook.mjs\" (node \"/Users/wkentaro/.agents/skills/impeccable/scripts/hook.mjs\" & exit /b)",
            "statusMessage": "Design deep pass",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ]
  }
}