#!/usr/bin/env python3

import argparse
import hashlib
import json
import math
import os
import sys
import tempfile
import time
import urllib.error
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timezone
from http.client import HTTPException
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path

ENDPOINTS = {
    "claude": "https://api.anthropic.com/api/oauth/usage",
    "codex": "https://chatgpt.com/backend-api/wham/usage",
}
AUTH_DIR = Path.home() / ".cli-proxy-api"
CACHE_DIR = Path.home() / ".cache" / "cliproxy-quota"
GATEWAY_SETTINGS = Path.home() / ".claude" / "settings-gateway.json"
CACHE_SECONDS = 300
MIN_RETRY_SECONDS = 60
MAX_RETRY_SECONDS = 3600
SERVE_PORT = 8318
SERVE_TIMEOUT = 5
MANAGEMENT_URL = "http://127.0.0.1:8317/v0/management/auth-files"
MANAGEMENT_KEY = Path.home() / ".config" / "cliproxyapi" / "management-key"
NAMED_WINDOWS = {"weekly": 604800, "daily": 86400}
PUBLIC_FIELDS = ("provider", "disabled", "windows", "fetched_at", "cached", "error")


class NoRedirects(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def clean_text(value):
    return "".join(c if c.isprintable() else "?" for c in str(value))


def percentage(value):
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    if not 0 <= value <= 100 or not math.isfinite(value):
        return None
    return value


def parse_time(value):
    try:
        if isinstance(value, bool) or value is None:
            return None
        if isinstance(value, (int, float)):
            return datetime.fromtimestamp(value, timezone.utc)
        reset = datetime.fromisoformat(value.replace("Z", "+00:00"))
        return reset.astimezone(timezone.utc) if reset.tzinfo else None
    except (ValueError, TypeError, AttributeError, OverflowError, OSError):
        return None


def local_time(value):
    reset = parse_time(value)
    try:
        return None if reset is None else reset.astimezone()
    except (OverflowError, OSError, ValueError):
        return None


def reset_text(value):
    reset = local_time(value)
    if reset is None:
        return "reset not reported"
    return "resets " + reset.strftime("%Y-%m-%d %H:%M %Z")


def bar(percent):
    filled = int(percent / 5 + 0.5)
    return "[" + "#" * filled + "-" * (20 - filled) + "]"


def window_seconds(label):
    for name, length in NAMED_WINDOWS.items():
        if label.endswith(name):
            return length
    count, _, unit = label.partition("-")
    try:
        seconds = float(count) * {"hour": 3600, "minute": 60, "second": 1}[unit]
    except (ValueError, KeyError):
        return None
    return seconds if math.isfinite(seconds) and seconds > 0 else None


def countdown(seconds):
    days, minutes = divmod(int(seconds // 60), 1440)
    hours, minutes = divmod(minutes, 60)
    if days:
        return f"{days}d {hours}h"
    if hours:
        return f"{hours}h {minutes}m"
    return f"{minutes}m"


def time_line(label, reset):
    reset_at, length = local_time(reset), window_seconds(label)
    if reset_at is None or length is None:
        return None
    left = max(0, reset_at.timestamp() - time.time())
    if left > length:
        return None
    same_day = reset_at.date() == datetime.now().date()
    clock = reset_at.strftime("%H:%M" if same_day else "%a %H:%M")
    percent = left / length * 100
    return (
        f"time  {bar(percent)} {percent:5.1f}% left"
        f"  {countdown(left)} to reset ({clock})"
    )


def window_line(label, used, reset):
    used = percentage(used)
    if used is None:
        return f"  {label:<16} not reported"
    remaining = 100 - used
    column = f"{label:<16}"
    line = f"  {column} quota {bar(remaining)} {remaining:5.1f}% left"
    time_row = time_line(label, reset)
    if time_row is None:
        return f"{line}  {reset_text(reset)}"
    return f"{line}\n  {' ' * len(column)} {time_row}"


def duration_label(seconds):
    for name, length in NAMED_WINDOWS.items():
        if seconds == length:
            return name
    if isinstance(seconds, (int, float)) and not isinstance(seconds, bool):
        if math.isfinite(seconds) and seconds > 0:
            if seconds % 3600 == 0:
                return f"{seconds / 3600:g}-hour"
            if seconds % 60 == 0:
                return f"{seconds / 60:g}-minute"
            return f"{seconds:g}-second"
    return "window"


def quota_windows(provider, data):
    if not isinstance(data, dict):
        raise ValueError("invalid response")
    if provider == "claude":
        windows = [("5-hour", data.get("five_hour")), ("weekly", data.get("seven_day"))]
        windows.extend(
            (key.removeprefix("seven_day_").replace("_", " ") + " weekly", value)
            for key, value in data.items()
            if key.startswith("seven_day_")
            and isinstance(value, dict)
            and "utilization" in value
        )
        windows = [
            (label, window.get("utilization"), window.get("resets_at"))
            if isinstance(window, dict)
            else (label, None, None)
            for label, window in windows
        ]
    else:
        limits = data.get("rate_limit")
        if not isinstance(limits, dict):
            raise ValueError("missing rate limits")
        windows = [
            (
                duration_label(window.get("limit_window_seconds")),
                window.get("used_percent"),
                window.get("reset_at"),
            )
            for window in (limits.get("primary_window"), limits.get("secondary_window"))
            if isinstance(window, dict)
        ]
    if not reported(windows):
        raise ValueError("missing quota windows")
    return windows


def reported(windows):
    return any(used is not None or reset is not None for label, used, reset in windows)


def window_lines(windows):
    return [
        window_line(clean_text(label), used, reset) for label, used, reset in windows
    ]


def fetch_usage(provider, auth, timeout):
    token = auth.get("access_token")
    if not isinstance(token, str) or not token:
        raise ValueError("missing access token")
    headers = {"Authorization": "Bearer " + token, "Accept": "application/json"}
    if provider == "claude":
        headers["anthropic-beta"] = "oauth-2025-04-20"
    else:
        account_id = auth.get("account_id")
        if not isinstance(account_id, str) or not account_id:
            raise ValueError("missing account ID")
        headers["ChatGPT-Account-Id"] = account_id
    request = urllib.request.Request(ENDPOINTS[provider], headers=headers)
    return open_json(request, timeout)


def open_json(request, timeout):
    opener = urllib.request.build_opener(NoRedirects())
    with opener.open(request, timeout=timeout) as response:
        return json.load(response)


def digest(text):
    return hashlib.sha256(text.encode()).hexdigest()[:32]


def timestamp(value):
    if isinstance(value, (int, float)) and not isinstance(value, bool):
        return value
    return 0


def read_json(path):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError, RecursionError):
        return None


def write_json(path, value):
    try:
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        CACHE_DIR.chmod(0o700)
        descriptor, temporary = tempfile.mkstemp(dir=CACHE_DIR)
        try:
            with os.fdopen(descriptor, "w") as file:
                json.dump(value, file)
            os.replace(temporary, path)
        except OSError:
            os.unlink(temporary)
            raise
    except OSError:
        pass


def cached_windows(path, now):
    entry = read_json(path)
    if not isinstance(entry, dict):
        return 0, None
    fetched_at = timestamp(entry.get("fetched_at"))
    windows = entry.get("windows")
    if not 0 < fetched_at <= now or not isinstance(windows, list) or not windows:
        return 0, None
    if not all(
        isinstance(window, list) and len(window) == 3 and isinstance(window[0], str)
        for window in windows
    ) or not reported(windows):
        return 0, None
    return fetched_at, windows


def as_of(fetched_at):
    fetched = datetime.fromtimestamp(fetched_at)
    same_day = fetched.date() == datetime.now().date()
    return "  as of " + fetched.strftime("%H:%M" if same_day else "%Y-%m-%d %H:%M")


def render(title, windows, fetched_at=None):
    if fetched_at is not None:
        title += as_of(fetched_at)
    shown = [window for window in windows if window[0] != "5-hour"]
    return title + "\n" + "\n".join(window_lines(shown))


def retry_seconds(error):
    retry_after = (error.headers or {}).get("Retry-After", "")
    if retry_after.isdecimal() and len(retry_after) <= 9:
        seconds = int(retry_after)
    else:
        seconds = CACHE_SECONDS
    return max(MIN_RETRY_SECONDS, min(seconds, MAX_RETRY_SECONDS))


def retrying(message, seconds):
    return f"{message}; retry in {math.ceil(seconds / 60)} min"


def pending_retry(path, now, credential):
    retry = read_json(path)
    if (
        not isinstance(retry, list)
        or len(retry) != 3
        or retry[2] not in (None, credential)
    ):
        return None
    retry_at, message = timestamp(retry[0]), retry[1]
    if not isinstance(message, str) or not now < retry_at <= now + MAX_RETRY_SECONDS:
        return None
    return retrying(clean_text(message), retry_at - now)


def account_status(path, timeout, providers=ENDPOINTS):
    status = {
        "file": clean_text(path.name),
        "provider": None,
        "email": None,
        "organization": None,
        "priority": None,
        "disabled": False,
        "windows": [],
        "fetched_at": None,
        "cached": False,
        "error": None,
    }
    try:
        text = path.read_text()
        auth = json.loads(text)
        if not isinstance(auth, dict):
            raise ValueError("invalid credential")
    except (OSError, ValueError, RecursionError):
        return {**status, "error": "Cannot read credential JSON"}
    provider = auth.get("type")
    if not isinstance(provider, str) or provider not in providers:
        return None
    email = clean_text(auth.get("email") or path.stem)
    priority = auth.get("priority")
    status.update(
        provider=provider,
        email=email,
        organization=clean_text(auth.get("organization_name") or "") or None,
        priority=priority if type(priority) is int and priority > 0 else None,
    )
    if auth.get("disabled"):
        return {**status, "disabled": True}
    account = f"{provider}\0{email}\0{path.resolve()}"
    key = digest(account)
    cache_path = CACHE_DIR / f"{key}.json"
    retry_path = CACHE_DIR / f"{key}.retry"
    now = time.time()
    fetched_at, windows = cached_windows(cache_path, now)
    if windows:
        status.update(windows=windows, fetched_at=fetched_at, cached=True)
    if windows and now - fetched_at < CACHE_SECONDS:
        return status
    credential = digest(text)
    retry = pending_retry(retry_path, now, credential)
    if retry:
        return {**status, "error": retry}
    seconds = MIN_RETRY_SECONDS
    try:
        windows = quota_windows(provider, fetch_usage(provider, auth, timeout))
        write_json(cache_path, {"fetched_at": now, "windows": windows})
        return {**status, "windows": windows, "fetched_at": now, "cached": False}
    except urllib.error.HTTPError as error:
        error.close()
        message = f"HTTP {error.code}"
        if error.code in (401, 403):
            message += "; re-login may be required"
        elif error.code == 429:
            seconds = retry_seconds(error)
            credential = None
    except (OSError, urllib.error.URLError, HTTPException):
        message = "Network request failed"
    except (ValueError, TypeError, OverflowError, RecursionError):
        message = "Invalid credentials or quota response"
    write_json(retry_path, [time.time() + seconds, message, credential])
    return {**status, "error": retrying(message, seconds)}


def account_text(status):
    if status["provider"] is None:
        return f"{status['file']}\n  {status['error']}"
    title = f"{status['provider']}  {status['email']}"
    if status["organization"]:
        title += f"  ({status['organization']})"
    if status["priority"]:
        title += f"  priority {status['priority']}"
    if status["disabled"]:
        return title + "\n  Disabled"
    if status["windows"]:
        fetched_at = status["fetched_at"] if status["cached"] else None
        title = render(title, status["windows"], fetched_at)
    if status["error"]:
        title += "\n  " + status["error"]
    return title


def iso_time(value):
    if value is None:
        return None
    return value.isoformat().replace("+00:00", "Z")


def account_json(status):
    windows = [
        {
            "label": clean_text(label),
            "used_percent": percentage(used),
            "resets_at": iso_time(parse_time(reset)),
        }
        for label, used, reset in status["windows"]
    ]
    fetched_at = iso_time(parse_time(status["fetched_at"]))
    return {**status, "fetched_at": fetched_at, "windows": windows}


def public_json(status):
    account = account_json(status)
    return {field: account[field] for field in PUBLIC_FIELDS}


def account_statuses(auth_dir, timeout, providers=ENDPOINTS):
    paths = sorted(path for path in auth_dir.iterdir() if path.suffix == ".json")
    with ThreadPoolExecutor(max_workers=4) as pool:
        statuses = list(
            pool.map(lambda path: account_status(path, timeout, providers), paths)
        )
    return [status for status in statuses if status is not None]


def rank_priorities(statuses):
    ranked = [status for status in statuses if status["priority"]]
    ranks = [
        1
        + sum(
            other["provider"] == status["provider"]
            and other["priority"] > status["priority"]
            for other in ranked
        )
        for status in ranked
    ]
    for status, rank in zip(ranked, ranks):
        status["priority"] = rank


def gateway_url():
    url = os.environ.get("ANTHROPIC_BASE_URL")
    if url is None:
        settings = read_json(GATEWAY_SETTINGS)
        env = settings.get("env") if isinstance(settings, dict) else None
        url = env.get("ANTHROPIC_BASE_URL") if isinstance(env, dict) else None
    return url.rstrip("/") if isinstance(url, str) else None


def gateway_status(number, account):
    provider, error = account.get("provider"), account.get("error")
    windows = account.get("windows")
    fetched = parse_time(account.get("fetched_at"))
    fetched_at = fetched.timestamp() if fetched else None
    if fetched_at is not None and not 0 < fetched_at <= time.time() + CACHE_SECONDS:
        fetched_at = None
    return {
        "file": f"#{number}",
        "provider": clean_text(provider) if isinstance(provider, str) else None,
        "email": f"#{number}",
        "organization": None,
        "priority": None,
        "disabled": account.get("disabled") is True,
        "windows": [
            (
                window.get("label"),
                window.get("used_percent"),
                window.get("resets_at"),
            )
            for window in (windows if isinstance(windows, list) else [])
            if isinstance(window, dict)
        ],
        "fetched_at": fetched_at,
        "cached": account.get("cached") is True,
        "error": clean_text(error) if isinstance(error, str) else None,
    }


def gateway_statuses(url, timeout):
    with urllib.request.urlopen(url + "/quota", timeout=timeout) as response:
        accounts = json.load(response)
    if not isinstance(accounts, list) or not all(
        isinstance(account, dict) for account in accounts
    ):
        raise ValueError("invalid quota response")
    return [
        gateway_status(number, account) for number, account in enumerate(accounts, 1)
    ]


def quota_server(auth_dir, fetch_timeout, port):
    class Handler(BaseHTTPRequestHandler):
        timeout = SERVE_TIMEOUT

        def do_GET(self):
            try:
                statuses = account_statuses(auth_dir, fetch_timeout)
            except OSError:
                self.send_error(503, "Cannot read the credential directory")
                return
            accounts = [public_json(status) for status in statuses]
            body = json.dumps(accounts).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

    return HTTPServer(("127.0.0.1", port), Handler)


def weekly_reset_minute(status, now):
    for label, _, reset in status["windows"]:
        if label == "weekly" and (reset_at := parse_time(reset)):
            if reset_at.timestamp() > now:
                return round(reset_at.timestamp() / 60)
    return None


def drain_priorities(statuses, now):
    claude = [status for status in statuses if status["provider"] == "claude"]
    resets = sorted(
        (minute, status["file"])
        for status in claude
        if (minute := weekly_reset_minute(status, now)) is not None
    )
    priorities = {status["file"]: 0 for status in claude}
    for priority, (_, file) in enumerate(reversed(resets), 1):
        priorities[file] = priority
    return priorities


def management_request(key, timeout, path="", body=None):
    request = urllib.request.Request(
        MANAGEMENT_URL + path,
        data=None if body is None else json.dumps(body).encode(),
        headers={"Authorization": "Bearer " + key, "Content-Type": "application/json"},
        method="GET" if body is None else "PATCH",
    )
    return open_json(request, timeout)


def prioritize(auth_dir, timeout):
    key = MANAGEMENT_KEY.read_text().strip()
    files = management_request(key, timeout)
    files = files.get("files") if isinstance(files, dict) else None
    if not isinstance(files, list) or not all(
        isinstance(file, dict) and isinstance(file.get("name"), str) for file in files
    ):
        raise ValueError("invalid management response")
    current = {file["name"]: file.get("priority") or 0 for file in files}
    statuses = account_statuses(auth_dir, timeout, {"claude"})
    for file, priority in drain_priorities(statuses, time.time()).items():
        if file in current and current[file] != priority:
            body = {"name": file, "priority": priority}
            management_request(key, timeout, "/fields", body)
            print(f"{file}  priority {current[file]} -> {priority}")


def positive_timeout(value):
    try:
        timeout = float(value)
    except ValueError:
        raise argparse.ArgumentTypeError("timeout must be a positive number") from None
    if not math.isfinite(timeout) or timeout <= 0:
        raise argparse.ArgumentTypeError("timeout must be a positive number")
    return timeout


def main(argv=None):
    parser = argparse.ArgumentParser(
        description="Show remaining Claude and Codex quota for local CLIProxyAPI accounts, or the gateway's /quota when there are none.",
        epilog="Read-only except prioritize. Output includes account emails. Text reset times use your local timezone; --json uses UTC.",
    )
    parser.add_argument(
        "command",
        nargs="?",
        choices=["serve", "prioritize"],
        help=f"serve: serve the --json accounts without file names, emails, or organizations on 127.0.0.1:{SERVE_PORT}; prioritize: give CLIProxyAPI's highest priority to the Claude account whose weekly quota resets first",
    )
    parser.add_argument(
        "--auth-dir",
        type=Path,
        help="CLIProxyAPI credential directory (default: ~/.cli-proxy-api)",
    )
    parser.add_argument(
        "--timeout",
        type=positive_timeout,
        default=10,
        help="socket timeout in seconds (default: 10)",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="print the accounts as a JSON array instead of text",
    )
    args = parser.parse_args(argv)
    auth_dir = (args.auth_dir or AUTH_DIR).expanduser()
    if args.command == "serve":
        return quota_server(auth_dir, args.timeout, SERVE_PORT).serve_forever()
    if args.command == "prioritize":
        try:
            prioritize(auth_dir, args.timeout)
        except (OSError, ValueError, HTTPException, RecursionError) as error:
            print(f"Cannot set priorities: {clean_text(error)}", file=sys.stderr)
            return 1
        return 0
    try:
        statuses = account_statuses(auth_dir, args.timeout)
    except OSError as error:
        statuses, no_accounts = None, isinstance(error, FileNotFoundError)
    else:
        no_accounts = not statuses
        rank_priorities(statuses)
    url = gateway_url() if no_accounts and args.auth_dir is None else None
    if url:
        try:
            statuses = gateway_statuses(url, args.timeout)
        except (OSError, ValueError, HTTPException, RecursionError):
            print(f"Cannot read {clean_text(url)}/quota.", file=sys.stderr)
            return 1
    elif statuses is None:
        print(
            "Cannot read the credential directory; check --auth-dir.", file=sys.stderr
        )
        return 1
    if args.json:
        to_json = public_json if url else account_json
        print(json.dumps([to_json(status) for status in statuses], indent=2))
    elif statuses:
        print("\n\n".join(account_text(status) for status in statuses))
    else:
        print("No Claude or Codex accounts found.")
    return int(not statuses or any(status["error"] for status in statuses))


if __name__ == "__main__":
    sys.exit(main())
