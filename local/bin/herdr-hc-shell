#!/bin/sh
# herdr TUI pane shell backed by herdr-core, like herdr-app: each pane runs in an hc
# terminal; closing the pane kills that terminal and its sub-agents. The terminal
# survives herdr server restarts and reattaches when the pane comes back.
# Use as [terminal] default_shell in ~/.config/herdr/config.toml.

# Kill $1's sub-agents, deepest first, sparing ones herdr-app shows (herdr.space).
# Mirrors kill() in herdr-app's src/window.rs. --all keeps finished parents in the
# walk, and hc ls has no labels, so ask hc get.
kill_tree() (  # subshell: sh has no locals, and this recurses
  for t in $(hc ls --all --json | jq -r --arg p "$1" '.terminals[] | select(.parent == $p) | .address'); do
    [ -n "$(hc get "$t" | jq -r '.labels["herdr.space"] // empty')" ] && continue
    kill_tree "$t"; hc kill "$t"; hc rm "$t"
  done
)

# The herdr pane whose process is $1.
pane_of() {
  for p in $(herdr pane list | jq -r '.result.panes[].pane_id'); do
    [ "$(herdr pane process-info --pane "$p" | jq -r .result.process_info.shell_pid)" = "$1" ] &&
      echo "$p" && return
  done
  return 1
}

if [ "$1" = --watch ]; then  # --watch <pid> <hc address>
  pane=$HERDR_PANE_ID
  while sleep 2; kill -0 "$2" 2>/dev/null; do
    # Moving a pane gives it a new id, which a restart restores; relabel to match.
    # The old id keeps answering for the moved pane, so compare what it returns.
    # ponytail: one herdr call per pane every 2s; follow herdr events if that shows up.
    cur=$(herdr pane process-info --pane "$pane" 2>/dev/null |
      jq -r --argjson pid "$2" '.result.process_info | select(.shell_pid == $pid) | .pane_id')
    [ -n "$cur" ] || cur=$(pane_of "$2") || continue
    [ "$cur" = "$pane" ] || { pane=$cur; hc label "$3" "herdr-tui.pane=$pane"; }
  done
  # Shell exited, or pane closed (server up, pane gone): end the terminal and its tree.
  # Server stopped, or the pane is back after a restart: keep it.
  if ! hc get "$3" 2>/dev/null | jq -e '.state == "live"' >/dev/null 2>&1 ||
     { herdr status server --json | jq -e .running && ! herdr pane get "$pane"; }; then
    kill_tree "$3"; hc kill "$3"; hc rm "$3"
  fi
  exit
fi

# herdr points $SHELL at this script, so find the real login shell.
sh=$SHELL
case $sh in *herdr-hc-shell|'')
  sh=$(getent passwd "$(id -un)" 2>/dev/null | cut -d: -f7)
  [ -n "$sh" ] || sh=$(dscl . -read "$HOME" UserShell 2>/dev/null | awk '{print $2}')
  sh=${sh:-/bin/sh} ;;
esac
[ -n "$HERDR_PANE_ID" ] && command -v hc >/dev/null && command -v jq >/dev/null || exec "$sh" -l

# Pane ids are per herdr session, and every session shares one core.
session=$(printf %s "$HERDR_SOCKET_PATH" | cksum | cut -d' ' -f1)
t=$(hc ls --json --label "herdr-tui.session=$session" --label "herdr-tui.pane=$HERDR_PANE_ID" |
  jq -r '.terminals[0].address // empty')
if [ -z "$t" ]; then
  # hc terminals get the core's env, so carry over what herdr set for the pane:
  # its ids for agent hooks and its forwarded ssh agent.
  set --
  for v in $(env | sed -n 's/^\(HERDR_[A-Z0-9_]*\)=.*/\1/p') SSH_AUTH_SOCK; do
    eval "val=\${$v-}"; [ -n "$val" ] && set -- "$@" "$v=$val"
  done
  t=$(hc run --bg --no-parent --json --cwd "$PWD" \
    --label "herdr-tui.session=$session" --label "herdr-tui.pane=$HERDR_PANE_ID" \
    -- env "$@" SHELL="$sh" "$sh" -l | jq -r '.address // empty')
  [ -n "$t" ] || exec "$sh" -l
fi
# herdr kills the pane's whole session on close, so the watcher starts a new one.
perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' "$0" --watch $$ "$t" >/dev/null 2>&1 </dev/null &
# herdr opens splits and tabs in the directory of this pane's foreground process
# group leader, which is this process. Stay in the hc terminal's foreground
# directory while hc attach runs as a child.
# ponytail: one hc get per pane per second; follow hc events if that shows up.
exec perl -MJSON::PP -MPOSIX=:sys_wait_h -e '
  my $t = shift;
  defined(my $pid = fork) or die "fork: $!\n";
  unless ($pid) { exec "hc", "attach", "--history", "2000", $t; exit 127 }
  while (waitpid($pid, WNOHANG) == 0) {
    my $j = eval { decode_json(`hc get $t 2>/dev/null`) };
    my $cwd = $j && $j->{foreground} && $j->{foreground}{cwd};
    chdir $cwd if $cwd;
    sleep 1;
  }
  exit($? >> 8);
' "$t"
