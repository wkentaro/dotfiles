#!/bin/bash

set -euo pipefail

if [[ $# -ne 1 || ( ! -f $1 && ! -d $1 ) ]]; then
  echo "Usage: $0 <file-or-directory>" >&2
  exit 1
fi

file=$1
# Keep the backup beside the source even when passed trailing slashes.
while [[ $file == */ && $file != / ]]; do
  file=${file%/}
done
backup="$file.$(date +%Y%m%d%H%M%S)"
counter=1
while [[ -e $backup ]]; do
  backup="$file.$(date +%Y%m%d%H%M%S).$counter"
  ((counter++))
done

mv -- "$file" "$backup"
printf '%s\n' "$backup"
