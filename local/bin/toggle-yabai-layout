#!/bin/sh

space=$(yabai -m query --spaces --space) || exit 1
index=$(printf '%s' "$space" | jq -er .index) || exit 1
layout=$(printf '%s' "$space" | jq -er 'if .type == "float" then "bsp" else "float" end') || exit 1
yabai -m space "$index" --layout "$layout" || exit 1

if [ "$layout" = bsp ]; then
    yabai -m query --windows --space "$index" |
        jq -r '.[] | select(."is-floating") | .id' |
        while read -r window; do
            yabai -m window "$window" --toggle float
        done
fi

"$HOME/.local/bin/set-yabai-border-color"
